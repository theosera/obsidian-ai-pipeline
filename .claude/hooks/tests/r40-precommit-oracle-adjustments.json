    "COMMAND_CONFIG_ROOT_UNINSPECTED": {
      "count": 2,
      "condition": "Command changes HOME to a source root not equal to inherited observed root; inspection does not open an arbitrary command-selected config tree.",
      "ordinaryCost": "Even a normal getter or stdout query before commit can stop UNKNOWN.",
      "exit": "Retain the needed HOME/config context; split only if equivalent and re-scan commit, or ask owner. Do not silently remove needed configuration."
    },
    "UNSUPPORTED_GREP_ARGV": {
      "count": 2,
      "condition": "Pinned Git rejects the original numeric context value or the unseparated dash path before default pager setup. These invalid argument modes are conservatively unmodelled; no dangerous runtime action is claimed.",
      "ordinaryCost": "The original invalid form now stops UNKNOWN. It is not a previously valid ordinary search.",
      "exit": "Use a valid numeric context value or an explicit path separator only when that represents the intended operation; retain target, source and other required settings, otherwise ask owner."
    }
