#!/bin/sh
# vault-ops pre-push guard (template; installed into the vault repo as
# .githooks/pre-push by install-vault-ops.sh and activated via
# `git config core.hooksPath .githooks`).
#
# Purpose: mechanically reject a push to the protected branch (default: main)
# when it is NOT a fast-forward of the current remote tip — the dual-writer
# race where the weekly ingest CI (or another clone) pushed first. The same
# condition also rejects `git push --force`, which would silently erase those
# commits; that force-push protection plus the actionable message (pointing at
# vault-push-perm) is the value of this hook. A plain non-ff push is also
# refused server-side, but only after contacting the remote and with a less
# actionable message.
#
# Why no `git fetch` here: git already contacted the remote during push
# negotiation and passes the authoritative current remote sha on stdin
# (<remote sha>). An earlier version fetched inside the hook, but a `git fetch`
# spawned while the parent `git push` holds the connection is unreliable and,
# on failure, fell through to a fail-open `exit 0` — so the guard silently let
# non-ff pushes reach the server (observed on a real iCloud vault). Comparing
# against git's own <remote sha> needs no network call and cannot fail open.
#
# Ancestry check: allowed iff <remote sha> is an ancestor of <local sha>
# (i.e. a fast-forward). If <remote sha> is not even a local object — which
# only happens when we are behind/diverged (a ff descendant is always present
# locally) — `merge-base --is-ancestor` errors non-zero and we reject
# (fail-CLOSED), which is exactly the accident this guard must catch.
#
# stdin protocol (one line per ref being pushed):
#   <local ref> SP <local sha> SP <remote ref> SP <remote sha> LF
#
# Portability: POSIX sh. No bashisms. English comments only; user-facing
# messages are Japanese (no emoji) per the obsidian-ai-pipeline guard style.

PROTECTED="$(git config --get vault-ops.protected-branch 2>/dev/null)"
[ -n "${PROTECTED}" ] || PROTECTED="main"

# git invokes pre-push as: <hook> <remote name> <remote url>
REMOTE_NAME="${1:-origin}"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref}" ] || continue
  # Only guard pushes that update the protected branch on the remote side.
  # Keying on remote_ref also catches `git push origin feature:main`.
  # Tags (refs/tags/...) never match and are naturally skipped.
  [ "${remote_ref}" = "refs/heads/${PROTECTED}" ] || continue
  # Branch deletion: local sha is all zeros (works for SHA-1 and SHA-256).
  case "${local_sha}" in
    *[!0]*) ;;
    *) continue ;;
  esac
  # Remote ref does not exist yet: remote sha is all zeros -> nothing to
  # clobber, so a first push of the branch is allowed.
  case "${remote_sha}" in
    *[!0]*) ;;
    *) continue ;;
  esac
  # Allowed iff the remote tip git negotiated is an ancestor of what we push
  # (fast-forward or identical). Diverged / behind / remote object absent
  # locally -> merge-base returns non-zero -> reject.
  if git merge-base --is-ancestor "${remote_sha}" "${local_sha}" >/dev/null 2>&1; then
    continue
  fi
  echo "push 拒否: ${REMOTE_NAME}/${PROTECTED} に先行コミットがあります (週次取込 CI の可能性)。" >&2
  echo "vault-push-perm を実行してください (自動で rebase してから push します)。手動なら: git pull --rebase" >&2
  echo "force push も先行コミットを消すため同様に拒否されます (vault-ops / .githooks/pre-push)。" >&2
  status=1
done
exit "${status}"
